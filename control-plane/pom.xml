<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.3</version>
        <relativePath/>
    </parent>

    <groupId>io.cutmesh</groupId>
    <artifactId>cutmesh-control-plane</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Cutmesh Control Plane (Parent)</name>
    <description>Multi-module Spring Boot 4 Control Plane, Hybrid Auto-Pilot Rig Scheduler, Hazelcast Cluster State, and OpenAI Gateway</description>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Massimo Lauri</name>
            <url>https://github.com/massimolauri</url>
        </developer>
    </developers>

    <properties>
        <java.version>17</java.version>
        <hazelcast.version>5.3.8</hazelcast.version>
    </properties>

    <modules>
        <module>cutmesh-common</module>
        <module>cutmesh-audit</module>
        <module>cutmesh-iam</module>
        <module>cutmesh-fleet</module>
        <module>cutmesh-orchestration</module>
        <module>cutmesh-gateway</module>
        <module>cutmesh-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.cutmesh</groupId>
                <artifactId>cutmesh-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.cutmesh</groupId>
                <artifactId>cutmesh-audit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.cutmesh</groupId>
                <artifactId>cutmesh-iam</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.cutmesh</groupId>
                <artifactId>cutmesh-fleet</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.cutmesh</groupId>
                <artifactId>cutmesh-orchestration</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.cutmesh</groupId>
                <artifactId>cutmesh-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hazelcast</groupId>
                <artifactId>hazelcast</artifactId>
                <version>${hazelcast.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
