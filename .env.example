# Cutmesh Control Plane & Docker Compose Environment Template
# Copy this file to `.env` and fill in strong secrets before starting services.

# PostgreSQL database password (required by docker-compose)
POSTGRES_PASSWORD=replace_with_strong_postgres_password

# HMAC-SHA256 JWT signing secret (at least 32 characters; required in production)
CUTMESH_JWT_SECRET=replace_with_at_least_32_char_random_hex_secret

# Public base URL where GPU workers reach the Control Plane HTTP API
CUTMESH_PUBLIC_HUB_URL=http://localhost:30885

# Initial SUPER_ADMIN account seeded on an empty database (optional if using UI registration + promotion)
CUTMESH_ADMIN_EMAIL=admin@cutmesh.local
CUTMESH_ADMIN_PASSWORD=replace_with_strong_initial_admin_password

# Container image printed in enrollment CLI/Docker commands
CUTMESH_WORKER_DOCKER_IMAGE=ghcr.io/massimolauri/cutmesh-worker:latest

# Optional Google OAuth2 Web Client ID (leave empty to keep Google SSO disabled)
CUTMESH_GOOGLE_CLIENT_ID=

# Enforce strict direct P2P UDP (1 = fail closed if hole-punching falls back to Relay)
CUTMESH_STRICT_DIRECT=1

# Ports exposed by docker-compose
CONTROL_PLANE_PORT=30885
DASHBOARD_PORT=30300
